  { patient_name: 'Ravi Patil', age: 45 }
  { patient_name: 'Priya Shah', age: 32 }
  { patient_name: 'Amit Joshi', age: 60 }
  { patient_name: 'Rahul Desai', age: 52 }

Query 3: $in: Cardiology or Neurology patients
  db.patients.find(
