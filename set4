  { patient_name: 'Rahul Desai', department: 'Neurology' }
  { patient_name: 'Karan Singh', department: 'Cardiology' }

Query 4: Logical $and: Cardiology patients younger than 65
  db.patients.find(
    { $and: [ { department: 'Cardiology' }, { age: { $lt: 65 } } ] },
    { _id: 0, patient_name: 1, age: 1, doctor_name: 1 }
  )

Output:
  { patient_name: 'Ravi Patil', age: 45, doctor_name: 'Dr. Mehta' }
  { patient_name: 'Amit Joshi', age: 60, doctor_name: 'Dr. Mehta' }

Query 5: Logical $or: Pediatrics patients or age above 65
  db.patients.find(
    { $or: [ { department: 'Pediatrics' }, { age: { $gt: 65 } } ] },
    { _id: 0, patient_name: 1, department: 1, age: 1 }
  )

Output:
  { patient_name: 'Neha More', age: 19, department: 'Pediatrics' }
  { patient_name: 'Karan Singh', age: 70, department: 'Cardiology' }

Query 6: $ne with sort: not Cardiology, youngest first
  db.patients.find(
    { department: { $ne: 'Cardiology' } },
    { _id: 0, patient_name: 1, department: 1, age: 1 }
  ).sort({ age: 1 })

Output:
  { patient_name: 'Neha More', age: 19, department: 'Pediatrics' }
  { patient_name: 'Sneha Rao', age: 28, department: 'Orthopedics' }
  { patient_name: 'Priya Shah', age: 32, department: 'Neurology' }
  { patient_name: 'Rahul Desai', age: 52, department: 'Neurology' }

Query 7: sort() descending with limit(): 3 oldest patients
  db.patients.find({}, { _id: 0, patient_name: 1, age: 1 })
