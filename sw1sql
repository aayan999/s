Example (SQL)
Both schemas below hold the same data and give the same result.

Star schema

  DROP DATABASE IF EXISTS star_db;
  CREATE DATABASE star_db;
  USE star_db;

  CREATE TABLE Dim_Customer (
     customer_id INT PRIMARY KEY, name VARCHAR(50),
     city VARCHAR(30), state VARCHAR(30));
  CREATE TABLE Dim_Product (
     product_id INT PRIMARY KEY, product_name VARCHAR(50),
     category VARCHAR(30), brand VARCHAR(30));
  CREATE TABLE Dim_Date (
     date_id INT PRIMARY KEY, order_date DATE,
     month INT, year INT);
  CREATE TABLE Fact_Sales (
     sales_id INT PRIMARY KEY,
     customer_id INT, product_id INT, date_id INT, amount DECIMAL(10,2),
     FOREIGN KEY (customer_id) REFERENCES Dim_Customer(customer_id),
     FOREIGN KEY (product_id) REFERENCES Dim_Product(product_id),
     FOREIGN KEY (date_id) REFERENCES Dim_Date(date_id)
  );

  INSERT INTO Dim_Customer VALUES (1,'Rahul','Pune','Maharashtra'),(2,'Amit','Bhopal','MP');
  INSERT INTO Dim_Product VALUES (1,'Laptop','Electronics','Asus'),(2,'Pen','Stationery','Cello');
  INSERT INTO Dim_Date VALUES (1,'2026-11-01',11,2026),(2,'2026-12-01',12,2026);
  INSERT INTO Fact_Sales VALUES (1,1,1,1,50000),(2,2,2,2,100),(3,1,2,2,50);

  SELECT * FROM Dim_Customer;
  SELECT * FROM Dim_Product;
  SELECT * FROM Dim_Date;
  SELECT * FROM Fact_Sales;

  SELECT
      F.Sales_ID,
      C.Name,
      P.Category,
      C.State,
      F.Amount
  FROM Fact_Sales F
  JOIN Dim_Customer C ON F.Customer_ID = C.Customer_ID
  JOIN Dim_Product P ON F.Product_ID = P.Product_ID;

Snowflake schema

  DROP DATABASE IF EXISTS snow_db;
  CREATE DATABASE snow_db;
  USE snow_db;

  CREATE TABLE Dim_City (city_id INT PRIMARY KEY,
     city_name VARCHAR(30), state_name VARCHAR(30));
  CREATE TABLE Dim_Customer (customer_id INT PRIMARY KEY,
     name VARCHAR(50), city_id INT,
     FOREIGN KEY (city_id) REFERENCES Dim_City(city_id));
  CREATE TABLE Dim_Category (category_id INT PRIMARY KEY, category_name VARCHAR(30));
  CREATE TABLE Dim_Product (product_id INT PRIMARY KEY,
     product_name VARCHAR(50), category_id INT,
     FOREIGN KEY (category_id) REFERENCES Dim_Category(category_id));
  CREATE TABLE Dim_Date (date_id INT PRIMARY KEY,
     order_date DATE, month INT, year INT);
  CREATE TABLE Fact_Sales (
     sales_id INT PRIMARY KEY,
     customer_id INT, product_id INT, date_id INT, amount DECIMAL(10,2),
     FOREIGN KEY (customer_id) REFERENCES Dim_Customer(customer_id),
     FOREIGN KEY (product_id) REFERENCES Dim_Product(product_id),
     FOREIGN KEY (date_id) REFERENCES Dim_Date(date_id)
  );

  INSERT INTO Dim_City VALUES (1,'Pune','Maharashtra'),(2,'Bhopal','MP');
  INSERT INTO Dim_Customer VALUES (1,'Rahul',1),(2,'Amit',2);
  INSERT INTO Dim_Category VALUES (1,'Electronics'),(2,'Stationery');
  INSERT INTO Dim_Product VALUES (1,'Laptop',1),(2,'Pen',2);
  INSERT INTO Dim_Date VALUES (1,'2026-11-01',11,2026),(2,'2026-12-01',12,2026);
  INSERT INTO Fact_Sales VALUES (1,1,1,1,50000),(2,2,2,2,100),(3,1,2,2,50);

  SELECT * FROM Dim_City;
  SELECT * FROM Dim_Customer;
  SELECT * FROM Dim_Category;
  SELECT * FROM Dim_Product;
  SELECT * FROM Dim_Date;
  SELECT * FROM Fact_Sales;

  SELECT
      F.Sales_ID,
      C.Name,
      Cat.Category_Name,
      Ci.State_Name,
      F.Amount
  FROM Fact_Sales F
  JOIN Dim_Customer C ON F.Customer_ID = C.Customer_ID
  JOIN Dim_City Ci ON C.City_ID = Ci.City_ID
  JOIN Dim_Product P ON F.Product_ID = P.Product_ID
  JOIN Dim_Category Cat ON P.Category_ID = Cat.Category_ID;

Q6. SQL Queries and OLAP

Code

  CREATE DATABASE IF NOT EXISTS prac;
  USE prac;

  CREATE TABLE sales (
     sale_id      INT,
     product_name VARCHAR(30),
     quantity     INT,
     amount       INT
  );

  INSERT INTO sales VALUES
  (1,'Pen',10,100),
  (2,'Book',5,250),
  (3,'Pen',20,200);

  SELECT * FROM sales;

  SELECT SUM(amount) AS total_sales FROM sales;

  SELECT product_name, SUM(amount) AS total_amount
  FROM sales
  GROUP BY product_name;

Role of OLAP in analysing sales data
OLAP (Online Analytical Processing) is used to analyse large amounts of data from different
points of view.

 • Multidimensional analysis. Sales can be viewed by dimensions such as product, time
   period and region.
 • Roll-up and drill-down. Roll-up shows yearly sales from monthly sales. Drill-down gives
   the reverse. Slice and dice show the sales of one product or one city, and pivot rotates the
   view.
 • Fast summaries. Totals and averages are returned quickly from a data warehouse that
   stores historical data.
 • Trend analysis. Past sales can be compared across months and years to find patterns and
   forecast demand.
 • Decision making. Management can find best-selling products, weak months and trends,
   and plan stock and offers.
