Step 1: Create the partitioned table
SQL:
  CREATE DATABASE IF NOT EXISTS exam_db;
  USE exam_db;

  CREATE TABLE Product (
      Product_ID INT NOT NULL,
      Product_Name VARCHAR(30),
      Category VARCHAR(20),
      Price INT NOT NULL,
      PRIMARY KEY (Product_ID, Price)
