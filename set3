-- Query: total sales by state and category (more joins than star)
SELECT s.State_Name, cat.Category_Name, SUM(f.Amount) AS Total_Sales
FROM Fact_Sales f
JOIN Dim_Customer c ON f.Customer_ID = c.Customer_ID
JOIN Dim_City ci ON c.City_ID = ci.City_ID
JOIN Dim_State s ON ci.State_ID = s.State_ID
JOIN Dim_Product p ON f.Product_ID = p.Product_ID
JOIN Dim_Category cat ON p.Category_ID = cat.Category_ID
GROUP BY s.State_Name, cat.Category_Name;

